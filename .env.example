# === Flame backend (sub-app of BananaTalk; mounted at /flamebackend/v1/*) ===
FLAME_MONGO_URI=mongodb://localhost:27017/flame
FLAME_JWT_SECRET=replace-me-with-32+-random-chars-prod
FLAME_JWT_REFRESH_SECRET=replace-me-with-different-32+-random-chars
FLAME_JWT_ACCESS_TTL=15m
FLAME_JWT_REFRESH_TTL=30d
FLAME_SPACES_BUCKET=flame-uploads
FLAME_ALLOWED_ORIGINS=https://flame.example.com,http://localhost:3001
# Social sign-in. Each provider is enabled purely by the presence of its vars
# (see flame/utils/socialVerify.js isConfigured) — an unset provider returns
# 501 PROVIDER_NOT_CONFIGURED rather than failing at verification time.
# Google: the WEB OAuth client ID. The mobile SDKs pass serverClientId so the
# minted token's `aud` is the web client, which is what is verified here.
FLAME_GOOGLE_CLIENT_ID=
# Apple: the audience to verify the identity token against — for a native iOS
# sign-in this is the app's bundle ID (com.flame.flame). No Team ID, Key ID or
# .p8 key is needed: only the id_token is verified, the authorization_code is
# never exchanged.
FLAME_APPLE_CLIENT_ID=
# Facebook: both are required. Used to build the app token for /debug_token,
# which confirms the access token was issued for this exact app.
FLAME_FACEBOOK_APP_ID=
FLAME_FACEBOOK_APP_SECRET=
# SPACES_ENDPOINT, DO_SPACES_KEY, DO_SPACES_SECRET are shared with BananaTalk
# SPACES_CDN_URL: custom Spaces CDN subdomain used to build public file URLs.
# Falls back to https://my-projects-media.sfo3.cdn.digitaloceanspaces.com if unset.
SPACES_CDN_URL=https://cdn.banatalk.com
