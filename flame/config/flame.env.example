# === Flame env reference (sub-app of BananaTalk) ===
# Documents every flame-specific env var, grouped by feature. Placeholders
# only — NO real secrets belong in this file. Copy the vars you need into
# the real .env (see repo-root .env.example for the BananaTalk-wide file).

# --- Database ---
# Flame's own MongoDB connection string (isolated from BananaTalk's DB).
FLAME_MONGO_URI=mongodb://localhost:27017/flame

# --- Auth ---
# Signing secret for flame access tokens. Must be >= 32 chars (enforced by flame/config/env.js).
FLAME_JWT_SECRET=replace-me-with-32-plus-random-chars
# Signing secret for flame refresh tokens. Must be different from FLAME_JWT_SECRET and >= 32 chars.
FLAME_JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-random-chars
# Access token lifetime (defaults to 15m if unset).
FLAME_JWT_ACCESS_TTL=15m
# Refresh token lifetime (defaults to 30d if unset).
FLAME_JWT_REFRESH_TTL=30d

# --- Storage ---
# DigitalOcean Spaces bucket used for flame media uploads.
FLAME_SPACES_BUCKET=flame-uploads
# NOTE: the underlying Spaces credentials (SPACES_ENDPOINT, DO_SPACES_KEY,
# DO_SPACES_SECRET) are SHARED with BananaTalk and are NOT duplicated here —
# they're validated/read from the repo-root .env (see flame/config/env.js).

# --- Push (Firebase) ---
# Firebase project ID for flame push notifications. Leaving this unset keeps
# flame/services/pushService.js inert (no-op, never throws).
FLAME_FIREBASE_PROJECT_ID=
# Absolute path to the flame Firebase service-account JSON file (used as
# require(FLAME_FIREBASE_SERVICE_ACCOUNT) to build push credentials). Leave
# unset to fall back to application-default credentials, if configured.
FLAME_FIREBASE_SERVICE_ACCOUNT=/path/to/flame-firebase-service-account.json

# --- Email (Mailgun) ---
# Flame-specific Mailgun API key. Isolated from BananaTalk's shared
# MAILGUN_API_KEY on purpose — flame must NEVER piggyback on BananaTalk's
# already-configured prod Mailgun account. Leaving this (or
# FLAME_MAILGUN_DOMAIN) unset keeps flame/utils/sendEmail.js and
# flame/services/emailScheduler.js fully inert (no-op, no timers, never
# throws) until both are provided.
FLAME_MAILGUN_API_KEY=
# Flame-specific Mailgun sending domain.
FLAME_MAILGUN_DOMAIN=
# Mailgun API region for the flame domain above. Use 'eu' for the EU API
# endpoint; anything else (including unset) uses the US endpoint.
FLAME_MAILGUN_REGION=us
# "From" address used on outbound flame emails.
FLAME_FROM_EMAIL=noreply@flame.example.com
# "From" display name used on outbound flame emails.
FLAME_FROM_NAME=Flame
